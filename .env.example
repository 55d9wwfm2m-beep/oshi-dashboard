# ────────────────────────────────────────────────
# PromptHub の環境変数（すべて任意）
#
# 未設定でもアプリは動作します。その場合、AI改善機能は
# サンプルの改善結果を返す「デモモード」で動きます。
#
# 以下の値はサーバー側でのみ読み込まれ、ブラウザへは渡りません。
# NEXT_PUBLIC_ プレフィックスは絶対に付けないでください。
# ────────────────────────────────────────────────

# 使用するAIプロバイダ: anthropic | openai | google
AI_PROVIDER=anthropic

# APIキー。設定されている場合のみ実APIモードで動作します。
AI_API_KEY=

# 使用するモデル（省略時はプロバイダごとの既定モデル）
# anthropic: claude-sonnet-4-5 / openai: gpt-4o-mini / google: gemini-2.0-flash
AI_MODEL=

# ────────────────────────────────────────────────
# 同一リポジトリに同居している既存アプリ（推し活ダッシュボード）用
# ────────────────────────────────────────────────
# OGP画像を絶対URLで解決するための公開URL
NEXT_PUBLIC_SITE_URL=
